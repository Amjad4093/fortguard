<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 15+: lets the SDK learn when the app's screen is being recorded or shared. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <!-- Owner confirmation uses the framework BiometricPrompt, which throws without this permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Cellular call detection. The customer grants it in the app; without it only VoIP calls are seen. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Approximate location, sent only when the customer turns sharing on. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The remote-access apps the SDK may check for, by name. Android shows an app no other package
         without this list, and the SDK never reads the customer's full app list. Keep it in step with
         EnvironmentChecks.REMOTE_ACCESS_PACKAGES. -->
    <queries>
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.carriez.flutter_hbb" />
    </queries>

    <application>
        <service
            android:name="com.fortguard.sdk.FortGuardMotionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Fraud prevention: motion checks while a banking session is open" />
        </service>
    </application>
</manifest>
